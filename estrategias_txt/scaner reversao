instrument {
    overlay = true,
    name = "REVERSAO_PRO",
    short_name = "REV_PRO",
    icon = "indicators:trend"
}

input_group {
    "Cores",
    comprar_color = input { default = "#00FF88", type = input.color },
    vender_color = input { default = "#FF3366", type = input.color },
    sup_color = input { default = "#00FF8866", type = input.color },
    res_color = input { default = "#FF336666", type = input.color },
    sup_din_color = input { default = "#00FF88AA", type = input.color },
    res_din_color = input { default = "#FF3366AA", type = input.color }
}

input_group {
    "Periodos",
    rsi_per = input { default = "14", type = input.string },
    ema_rapida = input { default = "9", type = input.string },
    ema_media = input { default = "50", type = input.string },
    suporte_per = input { default = "20", type = input.string },
    suporte_din_per = input { default = "50", type = input.string },
    scanner_velas = input { default = "5", type = input.string }
}

-- ============================================
-- 1. INDICADORES BASE
-- ============================================

RSI = rsi(close, rsi_per)
EMA9 = ema(close, ema_rapida)
EMA50 = ema(close, ema_media)

SUPORTE = lowest(low, suporte_per)
RESISTENCIA = highest(high, suporte_per)
SUPORTE_DIN = lowest(low, suporte_din_per)
RESISTENCIA_DIN = highest(high, suporte_din_per)

-- ============================================
-- 2. PADRES DE VELA
-- ============================================

corpo = (close > open) and (close - open) or (open - close)
sombra_inf = (close > open) and (open - low) or (close - low)
sombra_sup = (close > open) and (high - close) or (high - open)

martelo = (sombra_inf > corpo * 2) and (sombra_sup < corpo * 0.5) and (corpo > 0)
estrela_cadente = (sombra_sup > corpo * 2) and (sombra_inf < corpo * 0.5) and (corpo > 0)
engolfo_alta = (close > open) and (close[1] < open[1]) and (close > open[1]) and (open < close[1])
engolfo_baixa = (close < open) and (close[1] > open[1]) and (close < open[1]) and (open > close[1])

-- ============================================
-- 3. SCANNER MELHORADO DE VELAS ANTERIORES
-- ============================================

scan_velas = tonumber(scanner_velas) or 5

-- ============================================
-- 3.1 ANALISAR COR DAS VELAS
-- ============================================

cont_verde = 0
cont_vermelha = 0
for i = 1, scan_velas do
    if close[i] > open[i] then
        cont_verde = cont_verde + 1
    else
        cont_vermelha = cont_vermelha + 1
    end
end

-- MAIORIA DAS VELAS
scan_verde = cont_verde > cont_vermelha
scan_vermelha = cont_vermelha > cont_verde

-- PERCENTUAL DE VELAS DA MESMA COR
perc_verde = (cont_verde / scan_velas) * 100
perc_vermelha = (cont_vermelha / scan_velas) * 100

-- ============================================
-- 3.2 ANALISAR FORA DAS VELAS (CORPO)
-- ============================================

-- TAMANHO MDIO DO CORPO DAS VELAS
soma_corpo = 0
for i = 1, scan_velas do
    corpo_i = (close[i] > open[i]) and (close[i] - open[i]) or (open[i] - close[i])
    soma_corpo = soma_corpo + corpo_i
end
corpo_medio = soma_corpo / scan_velas

-- VELA ATUAL  FORTE (MAIOR QUE A MDIA)
vela_forte = corpo > corpo_medio * 1.3

-- ============================================
-- 3.3 ANALISAR SEQUNCIA DE VELAS (TENDNCIA)
-- ============================================

-- VERIFICA SE AS VELAS ESTO EM SEQUNCIA (TENDNCIA)
seq_alta = true
seq_baixa = true
for i = 1, scan_velas do
    if close[i] <= open[i] then
        seq_alta = false
    end
    if close[i] >= open[i] then
        seq_baixa = false
    end
end

-- VERIFICA SE A TENDNCIA EST PERDENDO FORA (VELAS MENORES NO FINAL)
forca_diminuiu = true
for i = 2, scan_velas do
    corpo_i = (close[i] > open[i]) and (close[i] - open[i]) or (open[i] - close[i])
    corpo_ant = (close[i-1] > open[i-1]) and (close[i-1] - open[i-1]) or (open[i-1] - close[i-1])
    if corpo_i > corpo_ant then
        forca_diminuiu = false
    end
end

-- ============================================
-- 3.4 ANALISAR SOMBRAS (REJEIO)
-- ============================================

-- SOMBRA SUPERIOR GRANDE (REJEIO DE ALTA)
sombra_sup_grande = sombra_sup > corpo * 2

-- SOMBRA INFERIOR GRANDE (REJEIO DE BAIXA)
sombra_inf_grande = sombra_inf > corpo * 2

-- ============================================
-- 4. FILTROS DE TENDNCIA
-- ============================================

tendencia_alta_compra = close > EMA9
tendencia_geral_alta_compra = close > EMA50
tendencia_baixa_venda = close < EMA9
tendencia_geral_baixa_venda = close < EMA50

perto_suporte_din = close <= SUPORTE_DIN * 1.02
perto_resistencia_din = close >= RESISTENCIA_DIN * 0.98

-- ============================================
-- 5. SINAIS COM SCANNER MELHORADO
-- ============================================

-- SINAL DE COMPRA
-- Vem de velas VERMELHAS + Reverso + Tendncia de ALTA + Suporte
sinal_compra = (RSI < 45 or martelo or engolfo_alta or vela_forte or sombra_inf_grande) and 
               scan_vermelha and
               tendencia_alta_compra and 
               tendencia_geral_alta_compra and 
               perto_suporte_din

-- SINAL DE VENDA
-- Vem de velas VERDES + Reverso + Tendncia de BAIXA + Resistncia
sinal_venda = (RSI > 55 or estrela_cadente or engolfo_baixa or vela_forte or sombra_sup_grande) and 
              scan_verde and
              tendencia_baixa_venda and 
              tendencia_geral_baixa_venda and 
              perto_resistencia_din

-- ============================================
-- 5.1 SINAIS DE ALERTA (FORA MDIA)
-- ============================================

-- ALERTA DE COMPRA (quando tem alguns sinais mas no todos)
alerta_compra = (RSI < 45 or martelo or engolfo_alta) and 
                scan_vermelha and
                tendencia_alta_compra and 
                perto_suporte_din

-- ALERTA DE VENDA
alerta_venda = (RSI > 55 or estrela_cadente or engolfo_baixa) and 
               scan_verde and
               tendencia_baixa_venda and 
               perto_resistencia_din

-- ============================================
-- 6. SISTEMA DE TRAVA
-- ============================================

ultimo_sinal = ultimo_sinal or 0

-- ============================================
-- 7. PLOTAGEM
-- ============================================

plot(SUPORTE, "Suporte", sup_color)
plot(RESISTENCIA, "Resistncia", res_color)
plot(SUPORTE_DIN, "Suporte Din", sup_din_color)
plot(RESISTENCIA_DIN, "Resistncia Din", res_din_color)

-- SINAL DE COMPRA
if sinal_compra and ultimo_sinal ~= 1 then
    plot_shape(1, "COMPRAR", shape_style.triangleup, shape_size.huge,
        comprar_color, shape_location.belowbar, 0, "REVERSO ALTA", comprar_color)
    ultimo_sinal = 1
end

-- SINAL DE VENDA
if sinal_venda and ultimo_sinal ~= -1 then
    plot_shape(1, "VENDER", shape_style.triangledown, shape_size.huge,
        vender_color, shape_location.abovebar, 0, "REVERSO BAIXA", vender_color)
    ultimo_sinal = -1
end

-- ALERTA DE COMPRA (crculo amarelo)
if alerta_compra and ultimo_sinal ~= 1 then
    plot_shape(1, "ALERTA", shape_style.circle, shape_size.medium,
        "#FFAA00", shape_location.belowbar, 0, "", "#FFAA00")
end

-- ALERTA DE VENDA
if alerta_venda and ultimo_sinal ~= -1 then
    plot_shape(1, "ALERTA", shape_style.circle, shape_size.medium,
        "#FFAA00", shape_location.abovebar, 0, "", "#FFAA00")
end