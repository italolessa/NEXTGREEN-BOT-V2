instrument {
    overlay = true,
    name = "TENDENCIA",
    short_name = "TND",
    icon = "indicators:trend"
}

input_group {
    "Cores",
    comprar_color = input { default = "green", type = input.color },
    vender_color = input { default = "red", type = input.color },
    positivo = input { default = "green", type = input.color },
    neutro = input { default = "white", type = input.color },
    negativo = input { default = "red", type = input.color },
    upline_color = input { default = "red", type = input.color },
    lowline_color = input { default = "green", type = input.color }
}

input_group {
    "Periodos",
    doch_time = input { default = "40", type = input.string },
    emaa_per = input { default = "21", type = input.string },
    emab_per = input { default = "200", type = input.string },
    emac_per = input { default = "14", type = input.string },
    emad_per = input { default = "34", type = input.string }
}

-- PARAMETROS
EMAA = ema(close, emaa_per)
EMAB = ema(close, emab_per) -- Mdia de 200: Usada para tendncia de longo prazo
EMAC = ema(hlc3, emac_per)
EMAD = ema(hlc3, emad_per)
upper = highest(high, doch_time)
lower = lowest(low, doch_time)

-- CALCULOS ORIGINAIS
TA = ((close > close[1]) and (close > EMAA) and (EMAA > EMAA[1]))
TB = ((close < close[1]) and (close < EMAA) and (EMAA < EMAA[1]))

-- CONDIES DE CRUZAMENTO (AO POTENCIAL)
ENC = ((EMAC[1] < EMAD[1]) and (EMAC > EMAD))
ENV = ((EMAC[1] > EMAD[1]) and (EMAC < EMAD))

-- NOVO: "SCANNER" DE TENDNCIA FORTE
-- Gera um sinal de COMPRA se houver cruzamento para cima,
-- mas apenas se a tendncia geral for forte e confirmada.
sinal_compra = ENC and
               (close > EMAB) and      -- 1. Preo acima da mdia de 200 (tendncia de alta)
               (EMAC > EMAD) and       -- 2. Mdias alinhadas em alta
               (close > close[3])      -- 3. Preo subiu nos ltimos 3 candles (momentum)

-- Gera um sinal de VENDA se houver cruzamento para baixo,
-- mas apenas se a tendncia geral for forte e confirmada.
sinal_venda = ENV and
              (close < EMAB) and       -- 1. Preo abaixo da mdia de 200 (tendncia de baixa)
              (EMAC < EMAD) and        -- 2. Mdias alinhadas em baixa
              (close < close[3])       -- 3. Preo caiu nos ltimos 3 candles (momentum)

-- SISTEMA DE TRAVA PARA EVITAR REPETIO DE SINAIS
ultimo_sinal = ultimo_sinal or 0

sec = security(current_ticker_id, "1m")
if sec then
    local bar_color
    if TA then bar_color = positivo
    elseif TB then bar_color = negativo
    else bar_color = neutro end
    
    plot_candle(open, high, low, close, "ES", bar_color)
    plot(upper, "Resistencia", upline_color)
    plot(lower, "Suporte", lowline_color)
    
    -- SINAL DE VENDA
    if sinal_venda and ultimo_sinal ~= -1 then
        plot_shape(1, "VENDER", shape_style.triangledown, shape_size.huge,
            vender_color, shape_location.abovebar, 0, "BIG VENDA", vender_color)
        ultimo_sinal = -1
    end
    
    -- SINAL DE COMPRA
    if sinal_compra and ultimo_sinal ~= 1 then
        plot_shape(1, "COMPRAR", shape_style.triangleup, shape_size.huge,
            comprar_color, shape_location.belowbar, 0, "BIG COMPRA", comprar_color)
        ultimo_sinal = 1
    end
end